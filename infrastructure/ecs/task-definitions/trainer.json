{
  "family": "bikepulse-dev-trainer-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::578771850678:role/bikepulse-dev-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::578771850678:role/bikepulse-dev-trainer-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "trainer",
      "image": "578771850678.dkr.ecr.ap-northeast-2.amazonaws.com/bikepulse/trainer:m001",
      "essential": true,
      "environment": [
        {
          "name": "BIKEPULSE_BUCKET",
          "value": "bikepulse-578771850678-ap-northeast-2"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "ap-northeast-2"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bikepulse-dev/trainer",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "command": [
        "python",
        "-u",
        "/app/training_worker.py"
      ]
    }
  ]
}
