{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "scheduler.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "578771850678"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:scheduler:ap-northeast-2:578771850678:schedule-group/default"
        }
      }
    }
  ]
}
