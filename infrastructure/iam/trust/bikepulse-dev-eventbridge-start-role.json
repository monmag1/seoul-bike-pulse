{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "578771850678"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:events:ap-northeast-2:578771850678:rule/bikepulse-dev-s3-ingestion"
        }
      }
    }
  ]
}
